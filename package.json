{
  "name": "dsh-usage-monitor",
  "version": "0.1.0",
  "description": "Always-visible DeepSeek credits and usage for the DSH Web GUI: balance left, spend per chat, today/month/all-time, converted to CHF.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "credits",
    "usage",
    "cost"
  ],
  "author": "Eric Ceglie",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericceg/dsh-usage-monitor.git"
  },
  "homepage": "https://github.com/ericceg/dsh-usage-monitor#readme",
  "bugs": {
    "url": "https://github.com/ericceg/dsh-usage-monitor/issues"
  }
}
